XAI_API_KEY=
# Verified against the official xAI model docs on 2026-08-31.
XAI_MODEL=grok-4.6
# The same server-only key may run one explicitly selected Phase 5 coverage-gap
# search. Gap searches are never started by the browser and are cached for six hours.

# Optional server-side Ticketmaster Discovery API credential. Never expose this
# through a VITE_ variable or client bundle. Missing credentials preserve the
# current last-good city snapshot and report Ticketmaster as unavailable.
TICKETMASTER_API_KEY=

# Optional server-side Billetto Public Event Search credentials. Both values
# are required. They are sent only in the Api-Keypair request header and must
# never use a VITE_ prefix or appear in generated snapshots.
BILLETTO_API_KEY=
BILLETTO_API_SECRET=

# Optional benchmark-only PredictHQ credential. Provider rows are written only
# to ignored coverage snapshots and can never become canonical inventory.
PREDICTHQ_API_KEY=

# Bandsintown keys are normally artist-scoped. Set the approval flag only after
# Bandsintown has approved Local Buzz organizational/partnership API use.
BANDSINTOWN_APP_ID=
BANDSINTOWN_TERMS_APPROVED=false
