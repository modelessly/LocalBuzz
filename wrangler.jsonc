{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "local-buzz",
  "compatibility_date": "2026-08-30",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "localbuzz.modeless.io",
      "custom_domain": true
    }
  ]
}
